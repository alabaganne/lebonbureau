# Copy to .env.local and fill in. For local dev, run `npm run db:start` then
# `supabase status` to read the values.

# Public — sent to the browser (safe: anon/publishable key, RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by scripts/seed-admin.mjs. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin account that `npm run seed:admin` creates and grants role=admin.
ADMIN_EMAIL=admin@lebonbureau.tn
ADMIN_PASSWORD=change-me
